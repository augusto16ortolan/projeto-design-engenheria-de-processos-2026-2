{
  "info": {
    "_postman_id": "5a21de48-d168-4f5a-a688-93283b5b0df1",
    "name": "Cena Marcada API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "workId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Maria\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login (save token)",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login realizado', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"professor@cenamarcada.dev\",\n  \"password\": \"123456\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Authenticated user",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/me" }
    },
    {
      "name": "List works",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/works?type=series&status=want_to_watch" }
    },
    {
      "name": "Create work (save workId)",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Obra criada', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('workId', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"type\": \"movie\",\n  \"title\": \"A Chegada\",\n  \"imageUrl\": \"\",\n  \"synopsis\": \"Contato com alienígenas.\",\n  \"status\": \"watching\"\n}" },
        "url": "{{baseUrl}}/works"
      }
    },
    {
      "name": "Get work",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/works/{{workId}}" }
    },
    {
      "name": "Update work",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"type\": \"movie\",\n  \"title\": \"A Chegada (editado)\",\n  \"imageUrl\": \"\",\n  \"synopsis\": \"Contato com alienígenas.\",\n  \"status\": \"watched\"\n}" },
        "url": "{{baseUrl}}/works/{{workId}}"
      }
    },
    {
      "name": "Delete work",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/works/{{workId}}" }
    }
  ]
}
