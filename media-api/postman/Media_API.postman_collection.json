{
  "info": {
    "_postman_id": "7ef4c25e-117f-429e-8586-9c5ae0c0d938",
    "name": "Media API",
    "description": "Complete collection for the Media API. Run Login first to save the JWT token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "mediaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (save token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"professor@media.dev\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "List Media",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/media"
          }
        },
        {
          "name": "Filter Media (all filters)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/media?type=series&genre=Ação&q=loki&year=2021&yearFrom=2020&yearTo=2022&minRating=8&sort=rating&order=desc&page=1&limit=5"
          }
        },
        {
          "name": "List Genres",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/media/genres"
          }
        },
        {
          "name": "Get Media by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/media/{{mediaId}}"
          }
        },
        {
          "name": "Create Media",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('mediaId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"series\",\n  \"title\": \"Example Series\",\n  \"year\": 2026,\n  \"duration\": \"8 episodes\",\n  \"seasons\": 1,\n  \"episodes\": 8,\n  \"genres\": [\"Action\", \"Adventure\"],\n  \"ageRating\": \"12 years\",\n  \"rating\": 8.1,\n  \"creator\": \"Example Creator\",\n  \"imageUrl\": \"https://example.com/poster.jpg\",\n  \"synopsis\": \"An example series used in class.\"\n}"
            },
            "url": "{{baseUrl}}/media"
          }
        },
        {
          "name": "Update Media",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"series\",\n  \"title\": \"Updated Example Series\",\n  \"year\": 2026,\n  \"duration\": \"8 episodes\",\n  \"seasons\": 1,\n  \"episodes\": 8,\n  \"genres\": [\"Action\", \"Adventure\"],\n  \"ageRating\": \"12 years\",\n  \"rating\": 8.5,\n  \"creator\": \"Example Creator\",\n  \"imageUrl\": \"https://example.com/poster.jpg\",\n  \"synopsis\": \"An updated example series used in class.\"\n}"
            },
            "url": "{{baseUrl}}/media/{{mediaId}}"
          }
        },
        {
          "name": "Delete Media",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/media/{{mediaId}}"
          }
        }
      ]
    }
  ]
}
